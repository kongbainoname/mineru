# ============================================
# MinerU PDF 解析服务 - 生产环境配置 (prod)
# ============================================
# 与 dev/test 环境差异：
#   1. 最大线程数和并发数，充分发挥硬件性能
#   2. LOG_LEVEL=WARNING，关闭访问日志
#   3. 关闭 API 文档
#   4. 关闭 STDIN EOF 自动关闭
#   5. 更长的任务保留时间
#   6. 最大资源限制
# ============================================

# ---------- 运行环境 ----------
APP_ENV=prod
LOG_LEVEL=WARNING

# ---------- 并发控制 ----------
# API 最大并发请求数
MINERU_API_MAX_CONCURRENT_REQUESTS=8
# pipeline 后端每批最大页数
MINERU_PROCESSING_WINDOW_SIZE=64

# ---------- 线程配置 ----------
# PDF 渲染进程数（最大 4）
MINERU_PDF_RENDER_THREADS=4
# PDF 渲染超时秒数（生产环境大文件需更长超时）
MINERU_PDF_RENDER_TIMEOUT=600
# ONNX Runtime 推理线程数（根据 CPU 核数调整）
OMP_NUM_THREADS=8
# MKL 线程数
MKL_NUM_THREADS=8
# OpenBLAS 线程数
OPENBLAS_NUM_THREADS=8

# ---------- 模型配置 ----------
MINERU_MODEL_SOURCE=modelscope
# 有 GPU 建议设为 cuda
MINERU_DEVICE_MODE=cpu

# ---------- 功能开关 ----------
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# ---------- 任务管理 ----------
# 任务输出根目录
MINERU_API_OUTPUT_ROOT=./output
# 生产环境保留 48h
MINERU_API_TASK_RETENTION_SECONDS=172800
# 过期任务清理间隔（秒）
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=900

# ---------- 安全与接口 ----------
# 生产环境关闭 API 文档
MINERU_API_ENABLE_FASTAPI_DOCS=false
# 关闭 HTTP 访问日志
MINERU_API_DISABLE_ACCESS_LOG=true
# 禁止 STDIN EOF 自动关闭
MINERU_API_SHUTDOWN_ON_STDIN_EOF=false

# ---------- VLM 预加载 ----------
# 生产环境根据内存情况决定（内存 >= 32G 可考虑开启）
MINERU_API_ENABLE_VLM_PRELOAD=false
