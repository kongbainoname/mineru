# ============================================
# MinerU PDF 解析服务 - 开发环境配置 (dev)
# ============================================
# 用法:
#   ./build.sh deploy          # 构建并启动
#   ./build.sh build           # 仅构建镜像
# ============================================

# ---------- 运行环境 ----------
APP_ENV=dev
LOG_LEVEL=DEBUG

# ---------- 并发控制 ----------
# API 最大并发请求数（默认 3）
MINERU_API_MAX_CONCURRENT_REQUESTS=3
# pipeline 后端每批最大页数（默认 64）
MINERU_PROCESSING_WINDOW_SIZE=64

# ---------- 线程配置 ----------
# PDF 渲染进程数（默认 4），开发环境 1 进程即可
MINERU_PDF_RENDER_THREADS=1
# PDF 渲染超时秒数
MINERU_PDF_RENDER_TIMEOUT=300
# ONNX Runtime 推理线程数
OMP_NUM_THREADS=2

# ---------- 模型配置 ----------
MINERU_MODEL_SOURCE=modelscope
# 计算设备：auto(自动) / cpu / cuda / mps
MINERU_DEVICE_MODE=auto

# ---------- 功能开关 ----------
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# ---------- 任务管理 ----------
# 任务输出根目录
MINERU_API_OUTPUT_ROOT=./output
# 任务结果保留时间（秒），开发环境 1h
MINERU_API_TASK_RETENTION_SECONDS=3600
# 过期任务清理间隔（秒）
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=300

# ---------- 接口文档 ----------
MINERU_API_ENABLE_FASTAPI_DOCS=true

# ---------- VLM 预加载 ----------
# 开发环境默认不预加载模型，节省启动时间和内存
MINERU_API_ENABLE_VLM_PRELOAD=false
