# ============================================
# MinerU PDF 解析服务 - 测试环境配置 (test)
# ============================================
# 与 dev 环境差异：
#   1. 更高的线程数和并发数
#   2. LOG_LEVEL=INFO
#   3. 不开启热重载
#   4. 更大的资源限制
# ============================================

# ---------- 运行环境 ----------
APP_ENV=test
LOG_LEVEL=INFO

# ---------- 并发控制 ----------
# API 最大并发请求数（默认 3），测试环境提高至 6
MINERU_API_MAX_CONCURRENT_REQUESTS=6
# pipeline 后端每批最大页数（默认 64）
MINERU_PROCESSING_WINDOW_SIZE=64

# ---------- 线程配置 ----------
# PDF 渲染进程数（默认 4）
MINERU_PDF_RENDER_THREADS=4
# PDF 渲染超时秒数
MINERU_PDF_RENDER_TIMEOUT=300
# ONNX Runtime 推理线程数
OMP_NUM_THREADS=4
# MKL 线程数（如使用 Intel MKL 加速）
# MKL_NUM_THREADS=4

# ---------- 模型配置 ----------
MINERU_MODEL_SOURCE=modelscope
# 计算设备（有 GPU 可填 cuda）
MINERU_DEVICE_MODE=auto

# ---------- 功能开关 ----------
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# ---------- 任务管理 ----------
# 任务输出根目录
MINERU_API_OUTPUT_ROOT=./output
# 任务结果保留时间（秒），测试环境 6h
MINERU_API_TASK_RETENTION_SECONDS=21600
# 过期任务清理间隔（秒）
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=600

# ---------- 接口文档 ----------
MINERU_API_ENABLE_FASTAPI_DOCS=true

# ---------- VLM 预加载 ----------
# 测试环境不预加载，保持灵活
MINERU_API_ENABLE_VLM_PRELOAD=false
