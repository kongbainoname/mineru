# Python virtual environment and cache
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
htmlcov/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# IDE and editor config
.idea/
.vscode/
.claude/
*.iml

# Git
.git/
.github/
.gitattributes

# Project outputs and runtime data (will be mounted as volumes)
output/
logs/
models/
deployment/models/
data/
*.log

# Environment files (security: do not copy secrets into image)
.env
.env.*
*.env

# Documentation, examples and deployment helpers
docs/
demo/
docker/
tests/

# Deployment configs (dockerfile paths still work via compose/build context)
deployment/*/.env.*
deployment/*/.env
deployment/*/build.sh
